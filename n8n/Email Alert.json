        {
            "parameters": {
                "isBodyHtml": true,
                "subject": "=[{{ ($json.urgency || 'MEDIUM').toUpperCase() }}] New email: {{ $json.subject_raw || '(no subject)' }}",
                "body": "=<!-- BRAND: card #10264A | panels #1B3868 | accent #3B82F6 | swap the ScalePods text for an <img> logo if you have a hosted URL -->\n<div style='margin:0;padding:24px 0;background:#F1F5F9;font-family:Segoe UI,Arial,sans-serif;'><table role='presentation' width='600' align='center' cellpadding='0' cellspacing='0' style='width:600px;max-width:100%;background:#10264A;border-radius:24px;overflow:hidden;'><tr><td align='center' style='padding:36px 32px 8px;'><span style='font-size:38px;font-weight:800;color:#FFFFFF;letter-spacing:0.5px;'>ScalePods</span></td></tr><tr><td align='center' style='padding:8px 32px 20px;font-size:22px;font-weight:700;color:#FFFFFF;'>New Email Needs Attention</td></tr><tr><td style='padding:0 36px 8px;color:#FFFFFF;font-size:16px;line-height:1.7;'><p style='margin:0 0 14px;'>Hi <b>Team</b>,</p><p style='margin:0 0 18px;'>A new email has arrived in the <b>info@scalepods.tech</b> inbox that needs a response.</p><span style='display:inline-block;background:{{ $json.badge_color }};color:#FFFFFF;font-size:12px;font-weight:700;letter-spacing:0.6px;text-transform:uppercase;padding:5px 12px;border-radius:999px;'>{{ $json.urgency }} priority &middot; {{ $json.category }}</span><div style='margin-top:18px;background:#1B3868;border-radius:14px;padding:18px 20px;'><table role='presentation' width='100%' cellpadding='0' cellspacing='0' style='font-size:14px;color:#E2E8F0;'><tr><td style='padding:5px 0;width:90px;color:#94A3B8;'>From</td><td style='padding:5px 0;'><b>{{ $json.from }}</b></td></tr><tr><td style='padding:5px 0;color:#94A3B8;'>Subject</td><td style='padding:5px 0;'>{{ $json.subject }}</td></tr><tr><td style='padding:5px 0;color:#94A3B8;'>Received</td><td style='padding:5px 0;'>{{ $json.received }} IST</td></tr></table><div style='margin-top:12px;padding:12px 14px;background:#10264A;border-left:4px solid #3B82F6;border-radius:0 8px 8px 0;font-size:15px;color:#FFFFFF;line-height:1.6;'>{{ $json.message }}</div></div><div style='margin-top:18px;background:#1B3868;border-radius:14px;padding:18px 20px;font-size:14px;color:#E2E8F0;line-height:1.6;'><div style='font-size:12px;font-weight:700;color:#7DD3FC;letter-spacing:0.6px;text-transform:uppercase;margin-bottom:8px;'>AI insight</div><p style='margin:0 0 8px;'><b>Summary:</b> {{ $json.summary }}</p><p style='margin:0;'><b>Suggested next step:</b> {{ $json.next_step }}</p></div><p style='margin:26px 0 8px;text-align:center;'><a href='{{ $json.gmail_link }}' style='display:inline-block;background:#3B82F6;color:#FFFFFF;text-decoration:none;font-size:15px;font-weight:700;padding:13px 28px;border-radius:10px;'>Open in Gmail</a></p></td></tr><tr><td align='center' style='padding:18px 32px 28px;font-size:12px;color:#94A3B8;'>Automated alert from ScalePods &middot; info@scalepods.tech inbox</td></tr></table></div>",
                "fromEmail": "info@scalepods.tech",
