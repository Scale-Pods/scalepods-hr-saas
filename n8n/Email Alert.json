        {
            "parameters": {
                "mode": "runOnceForEachItem",
                "jsCode": "let src = {};\ntry {\n  src = $('Block Warmup Emails').item.json;\n} catch (e1) {\n  try {\n    src = $('Gmail Trigger').first().json;\n  } catch (e2) {\n    src = {};\n  }\n}\nconst esc = s => String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\nlet raw = String($json.output || '').replace(/```(?:json)?/g,'').trim();\nlet d;\ntry { d = JSON.parse(raw); } catch (e) { d = { needs_alert: true, category: 'Unclassified', urgency: 'medium', summary: 'Could not auto-classify this email.', suggested_next_step: 'Review it manually.' }; }\nconst urgency = String(d.urgency || 'medium').toLowerCase();\nconst colors = { high: '#EF4444', medium: '#F59E0B', low: '#22C55E' };\nconst fromVal = src.From || src.from?.text || src.from?.value?.[0]?.address || src.from || '';\nconst subjVal = src.Subject || src.subject || '(no subject)';\nconst msgVal = src.snippet || src.text || src.body || '';\nreturn { json: {\n  needs_alert: d.needs_alert === true || d.needs_alert === 'true',\n  category: esc(d.category || 'General'),\n  urgency: urgency,\n  badge_color: colors[urgency] || '#F59E0B',\n  summary: esc(d.summary || 'General inquiry'),\n  next_step: esc(d.suggested_next_step || 'Review in inbox'),\n  from: esc(fromVal),\n  subject: esc(subjVal),\n  subject_raw: subjVal,\n  message: esc(msgVal),\n  received: new Date().toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', dateStyle: 'medium', timeStyle: 'short' }),\n  gmail_link: 'https://mail.google.com/mail/u/0/#inbox/' + (src.threadId || src.id || '')\n} };"
            },
