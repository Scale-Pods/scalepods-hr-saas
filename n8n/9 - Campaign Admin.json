      "parameters": {
        "jsCode": "// Count idiom: array length from the filtered REST query response (same idiom used by\n// \"Supabase - List campaigns (RLS-scoped)\" elsewhere in this workflow - fetch rows, count items).\nconst count = $input.all().length;\nconst body = $node[\"Webhook - /campaigns\"].json.body;\nreturn [{ json: { account_id: body.account_id, count } }];"
      },
