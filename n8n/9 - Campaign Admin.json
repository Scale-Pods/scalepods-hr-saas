        "jsCode": "// One row per round, from the body's rounds array: [{round_number, round_type, interviewer_email, cutoff_score}]\nconst campaignId = $json.id;\nconst rounds = $node[\"Webhook - /campaigns\"].json.body.rounds || [];\nreturn rounds.map(r => ({ json: { campaign_id: campaignId, ...r } }));"
