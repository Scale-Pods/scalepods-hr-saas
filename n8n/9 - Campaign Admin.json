    {
      "parameters": {
        "jsCode": "// Count idiom: array length from the filtered REST query response.\n// When alwaysOutputData is true and Supabase returns an empty array [], n8n emits a fallback item [{ json: {} }].\n// We filter for items with an id so empty results evaluate to 0 instead of 1.\nconst items = $input.all().filter(item => item.json && item.json.id);\nconst count = items.length;\nconst body = $node[\"Webhook - /campaigns\"].json.body;\nreturn [{ json: { account_id: body.account_id, count } }];"
      },
      "id": "99596ab6-fd24-46b7-b645-271daa8f7ded",
      "name": "Count Active Campaigns",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
