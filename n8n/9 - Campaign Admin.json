    {
      "parameters": {
        "jsCode": "// Combine check_tier_limit's `allowed` with the tier's overage_behavior.\n// Growth's overage_behavior = 'metered': an over-limit campaign is still ALLOWED, but logged\n// as a usage_events row for billing. Free/Basic overage_behavior = 'hard_stop': block outright.\nconst tierLimit = $node[\"Supabase - Check Tier Limit — Active Campaigns\"].json;\nconst overageRow = ($input.all()[0] && $input.all()[0].json) || {};\nconst overageBehavior = overageRow.overage_behavior || 'hard_stop';\nconst allowed = tierLimit.allowed === true;\nconst overLimit = !allowed;\nconst proceed = allowed || overageBehavior === 'metered';\nconst body = $node[\"Webhook - /campaigns\"].json.body;\nreturn [{\n  json: {\n    proceed,\n    over_limit: overLimit,\n    allowed,\n    overage_behavior: overageBehavior,\n    tier: tierLimit.tier,\n    limit_value: tierLimit.limit_value,\n    current_count: tierLimit.current_count,\n    account_id: body.account_id\n  }\n}];"
      },
      "id": "1eafbc73-a16f-442a-9c4d-6db1339526d3",
      "name": "Decide Tier Limit Outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
