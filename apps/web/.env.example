# Public (safe in the client bundle) - Next.js requires the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# n8n root only - the client appends /webhook/<path> itself.
NEXT_PUBLIC_N8N_BASE_URL=https://<your-n8n-host>
# Public URL of web app
NEXT_PUBLIC_FRONTEND_URL=https://scalepods.tech

# Razorpay Key ID (Live begins with rzp_live_...)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_...
NEXT_PUBLIC_APP_ENV=production

# Server-only - NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=your_live_key_secret
RAZORPAY_WEBHOOK_SECRET=your_live_webhook_secret

# Active Currency (defaults to INR: Basic=₹1, Growth=₹2, Enterprise=₹3)
RAZORPAY_CURRENCY=INR

# Optional explicit Live Plan IDs (auto-created on the fly if left empty)
RAZORPAY_PLAN_BASIC_ID=
RAZORPAY_PLAN_GROWTH_ID=
RAZORPAY_PLAN_ENTERPRISE_ID=

# Offer Letter PDF Conversion (Generic Multi-Tenant Engine)
# Choose "gotenberg" (local / containerized LibreOffice) or "cloudconvert" (hosted API)
PDF_CONVERTER=gotenberg
GOTENBERG_URL=http://localhost:3000
CLOUDCONVERT_API_KEY=your_cloudconvert_api_key

# Offer Letter AI Suggestions (Phase 4: Field-Marking Wizard)
ANTHROPIC_API_KEY=your_anthropic_api_key
OFFER_SUGGEST_MODEL=claude-3-5-sonnet-20241022

# ── Channel Integrations: Email (Google OAuth2) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Channel Integrations: WhatsApp Business (Meta Embedded Signup) ──
NEXT_PUBLIC_META_APP_ID=
META_APP_ID=
META_APP_SECRET=
NEXT_PUBLIC_META_CONFIG_ID=
