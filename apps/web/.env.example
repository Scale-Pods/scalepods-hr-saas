# Public (safe in the client bundle) - Next.js requires the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# n8n root only - the client appends /webhook/<path> itself.
NEXT_PUBLIC_N8N_BASE_URL=https://<your-n8n-host>
# Public URL of web app
NEXT_PUBLIC_FRONTEND_URL=https://scalepods-hr-saas-web.vercel.app

# Razorpay Key ID (Live begins with rzp_live_...)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_...
NEXT_PUBLIC_APP_ENV=production

# Server-only - NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=your_live_key_secret
RAZORPAY_WEBHOOK_SECRET=your_live_webhook_secret

# Active Currency (defaults to INR: Basic=₹1, Growth=₹2, Enterprise=₹3)
RAZORPAY_CURRENCY=INR

# Optional explicit Live Plan IDs (auto-created on the fly if left empty)
RAZORPAY_PLAN_BASIC_ID=
RAZORPAY_PLAN_GROWTH_ID=
RAZORPAY_PLAN_ENTERPRISE_ID=
