# Public (safe in the client bundle) - Next.js requires the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# n8n root only - the client appends /webhook/<path> itself. A /webhook suffix
# here would produce a broken double-`/webhook/webhook` URL.
NEXT_PUBLIC_N8N_BASE_URL=https://<your-n8n-host>
# This app's public URL; must match workflow 10's redirect_uri.
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_ENV=local

# Server-only - NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
